<?xml version="1.0"?>
<robot name="solar_tracker_v2">
  <material name="alu"><color rgba="0.75 0.77 0.8 1"/></material>
  <material name="panel"><color rgba="0.1 0.2 0.5 0.8"/></material>
  <link name="world"/>
  <joint name="world_joint" type="fixed"><parent link="world"/><child link="base_link"/></joint>
  <link name="base_link"><visual><geometry><mesh filename="package://solar_tracker_v2/meshes/base.stl"/></geometry><material name="alu"/></visual>
    <inertial><origin xyz="-0.00056 0.00215 0.12479"/><mass value="2.5661"/><inertia ixx="0.0128003" iyy="0.0160353" izz="0.00974364" ixy="5.83167e-05" ixz="-9.72938e-05" iyz="0.000228433"/></inertial></link>
  <link name="azimuth_link"><visual><geometry><mesh filename="package://solar_tracker_v2/meshes/azimuth_link.stl"/></geometry><material name="alu"/></visual>
    <inertial><origin xyz="-0.00024 -0.00007 0.03668"/><mass value="1.6020"/><inertia ixx="0.00135993" iyy="0.0024542" izz="0.00240587" ixy="7.40265e-07" ixz="-0.000152275" iyz="-3.73284e-08"/></inertial></link>
  <link name="elevation_link"><visual><geometry><mesh filename="package://solar_tracker_v2/meshes/elevation_link.stl"/></geometry><material name="panel"/></visual>
    <inertial><origin xyz="0.01262 0.00023 0.03282"/><mass value="3.7821"/><inertia ixx="0.0546584" iyy="0.107684" izz="0.160004" ixy="3.415e-05" ixz="0.00054677" iyz="0.000369355"/></inertial></link>
  <joint name="azimuth_joint" type="revolute"><parent link="base_link"/><child link="azimuth_link"/>
    <origin xyz="0 0 0.2063"/><axis xyz="0 0 -1"/><dynamics damping="0.2" friction="0.05"/>
    <limit lower="-3.2289" upper="3.2289" effort="1.500" velocity="1"/></joint>
  <joint name="elevation_joint" type="revolute"><parent link="azimuth_link"/><child link="elevation_link"/>
    <origin xyz="0 0 0.0858"/><axis xyz="1 0 0"/><dynamics damping="0.2" friction="0.05"/>
    <limit lower="-0.7854" upper="0.7854" effort="7.500" velocity="1"/></joint>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>azimuth_joint</joint_name><p_gain>303.80</p_gain><i_gain>0</i_gain><d_gain>0.000</d_gain><cmd_max>1.500</cmd_max><cmd_min>-1.500</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elevation_joint</joint_name><p_gain>160.99</p_gain><i_gain>0</i_gain><d_gain>0.000</d_gain><cmd_max>7.500</cmd_max><cmd_min>-7.500</cmd_min>
    </plugin>
  </gazebo>
</robot>
